#!/usr/bin/env bash
# help: use the HDMI monitor only (turns the laptop screen off)
set -euo pipefail

die() { echo "external: $*" >&2; exit 1; }
[[ -n ${SWAYSOCK:-} ]] || die "start the display first"

outs=$(swaymsg -t get_outputs) || die "can't reach sway"
panel='^(eDP|LVDS)'
int=$(jq -r --arg p "$panel" 'first(.[] | select(.name | test($p)) | .name) // empty' <<<"$outs")
ext=$(jq -r --arg p "$panel" 'first(.[] | select(.name | test($p) | not) | .name) // empty' <<<"$outs")
[[ -n $ext ]] || die "no external monitor connected"

# Monitor on first, then the panel off; sway moves its workspaces over.
cmd="output $ext enable; output $ext position 0 0"
[[ -n $int ]] && cmd+="; output $int disable"
swaymsg -q "$cmd" || die "sway refused the change"
echo "External monitor only ($ext). Unplug it, or type 'single', to get the laptop screen back."
