#!/usr/bin/env bash
# help: list screens, their state, current mode and available modes
set -euo pipefail

die() { echo "screens: $*" >&2; exit 1; }
[[ -n ${SWAYSOCK:-} ]] || die "start the display first"

outs=$(swaymsg -t get_outputs) || die "can't reach sway"
jq -r '
  def mode: "\(.width)x\(.height)"
    + (if (.refresh // 0) > 0 then "@\((.refresh / 1000) | round)Hz" else "" end);
  .[] |
  "\(.name)  \(if .active then "on" else "off" end)  \(.make) \(.model)",
  (if .active and .current_mode then
     "  now:   \(.current_mode | mode) at \(.rect.x),\(.rect.y), scale \(.scale)"
   elif .active then "  now:   on" else "  now:   off" end),
  "  modes: \(.modes | unique_by([.width, .height, .refresh])
                   | sort_by(-.width, -.height, -.refresh) | map(mode) | join(", "))",
  ""
' <<<"$outs"
