#!/usr/bin/env bash
# help: extend the display to the HDMI monitor: extend [left|right|above] (default right)
set -euo pipefail

die() { echo "extend: $*" >&2; exit 1; }
[[ -n ${SWAYSOCK:-} ]] || die "start the display first"

side=${1:-right}
case $side in
  left | right | above) ;;
  *) die "usage: extend [left|right|above]" ;;
esac

outs=$(swaymsg -t get_outputs) || die "can't reach sway"
panel='^(eDP|LVDS)'
int=$(jq -r --arg p "$panel" 'first(.[] | select(.name | test($p)) | .name) // empty' <<<"$outs")
ext=$(jq -r --arg p "$panel" 'first(.[] | select(.name | test($p) | not) | .name) // empty' <<<"$outs")
[[ -n $int ]] || die "laptop screen not found"
[[ -n $ext ]] || die "no external monitor connected"

swaymsg -q "output $int enable; output $ext enable" || die "sway refused to enable $ext"

# Sizes in layout pixels (after scale) once both are on.
outs=$(swaymsg -t get_outputs)
size() { jq -r --arg n "$1" '.[] | select(.name == $n) | "\(.rect.width) \(.rect.height)"' <<<"$outs"; }
read -r iw ih < <(size "$int")
read -r ew eh < <(size "$ext")

case $side in
  right) ix=0;   iy=0; ex=$iw; ey=0 ;;
  left)  ex=0;   ey=0; ix=$ew; iy=0 ;;
  above)
    # Centre the narrower screen under or over the wider one.
    if (( ew >= iw )); then ex=0; ix=$(( (ew - iw) / 2 )); else ix=0; ex=$(( (iw - ew) / 2 )); fi
    ey=0; iy=$eh ;;
esac

swaymsg -q "output $int position $ix $iy; output $ext position $ex $ey" \
  || die "sway refused the new layout"
case $side in above) where="above" ;; *) where="$side of" ;; esac
echo "Extended: $ext (${ew}x${eh}) is $where the laptop screen (${iw}x${ih})."
