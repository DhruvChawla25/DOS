#!/usr/bin/env bash
# help: Next track
set -euo pipefail
# MPRIS through playerctl: Spotify if it's running, otherwise any other player.
command -v playerctl >/dev/null 2>&1 || { echo "next: playerctl is not installed; run dos-update" >&2; exit 1; }
playerctl --player=spotify,%any next 2>/dev/null || { echo "next: no music player is running" >&2; exit 1; }
