#!/usr/bin/env bash
# help: Play music (Spotify first, else any player)
set -euo pipefail
# MPRIS through playerctl: Spotify if it's running, otherwise any other player.
command -v playerctl >/dev/null 2>&1 || { echo "play: playerctl is not installed; run dos-update" >&2; exit 1; }
playerctl --player=spotify,%any play 2>/dev/null || { echo "play: no music player is running" >&2; exit 1; }
