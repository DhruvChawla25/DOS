#!/usr/bin/env bash
# help: web <words or url> — open a URL in Chrome, or search Google for the words
set -euo pipefail

(( $# >= 1 )) || { echo "usage: web <words or url>" >&2; exit 1; }

# Percent-encode a search query (UTF-8 bytes; spaces become +).
urlencode() {
  local LC_ALL=C s=$1 out='' c i
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    case $c in
      [A-Za-z0-9.~_-]) out+=$c ;;
      ' ') out+='+' ;;
      *) printf -v c '%%%02X' "$(( $(printf '%d' "'$c") & 255 ))"; out+=$c ;;
    esac
  done
  printf '%s' "$out"
}

input="$*"
if (( $# == 1 )) && [[ $1 =~ ^[A-Za-z][A-Za-z0-9+.-]*:// || $1 =~ ^(about|chrome|file|mailto): ]]; then
  url=$1                                   # has a scheme: use it as is
elif (( $# == 1 )) && [[ $1 =~ ^(localhost|[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}|[0-9]{1,3}(\.[0-9]{1,3}){3})(:[0-9]+)?(/.*)?$ ]]; then
  # looks like a host (example.com/path): https, but plain http for local ones
  if [[ $1 =~ ^(localhost|[0-9.]+)(:|/|$) ]]; then url="http://$1"; else url="https://$1"; fi
else
  url="https://www.google.com/search?q=$(urlencode "$input")"
fi

exec "$(dirname "$(readlink -f "$0")")/chrome" "$url"
