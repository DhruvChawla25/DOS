#!/usr/bin/env bash
# help: Spotify music player (spotify --x11 runs it through XWayland)
set -euo pipefail

die() { printf 'spotify: %s\n' "$*" >&2; exit 1; }

[[ -n ${SWAYSOCK:-} ]] || die "start the display first"
command -v spotify-launcher >/dev/null 2>&1 || die "not installed; run dos-update"

case "${1:-}" in
  "")
    # spotify-launcher downloads or updates Spotify if needed, then starts it
    # with the flags in ~/.config/spotify-launcher.conf (native Wayland).
    swaymsg -q exec -- spotify-launcher || die "sway could not start it"
    ;;
  --x11)
    # Fallback if native Wayland misbehaves: run the installed binary directly
    # under XWayland. spotify-launcher has no way to pass extra flags per run.
    bin="${XDG_DATA_HOME:-$HOME/.local/share}/spotify-launcher/install/usr/bin/spotify"
    [[ -x $bin ]] || die "Spotify isn't downloaded yet; run 'spotify' once first"
    swaymsg -q exec -- "$(printf '%q' "$bin")" --ozone-platform=x11 || die "sway could not start it"
    ;;
  *)
    die "unknown option '$1' (use: spotify, or spotify --x11)"
    ;;
esac
